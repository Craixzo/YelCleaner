# Bot token from https://discord.com/developers/applications -> Bot
DISCORD_TOKEN=

# Right-click your server -> Copy Server ID (Developer Mode on)
GUILD_ID=737823381218525184

# Normal link to the sheet (the tab's #gid=... is kept). Sharing must be "Anyone with the link: Viewer".
SHEET_URL=https://docs.google.com/spreadsheets/d/1FhgGRHLT_M3QQqRXhjd3pJAHWBQOKqFuVNREiDGfifs/edit?usp=sharing

# Column holding the Discord IDs: a letter (A, B, ...) or the header text (e.g. "Discord ID")
ID_COLUMN=A

# Shows in the audit log
BAN_REASON=User flagged for being in condo servers. 

# Delete their recent messages: 0 = none, 86400 = 1 day, 604800 = 7 days (max)
DELETE_MESSAGE_SECONDS=0

# Comma-separated IDs that must never be banned (owner and bot are protected automatically)
PROTECTED_IDS=
